{
  "name": "curve-navigation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@curve/web",
    "build": "npm run build --workspace=@curve/web",
    "check": "npm run check --workspace=@curve/web && npm run check --workspace=@curve/api",
    "dev:api": "npm run dev --workspace=@curve/api"
  },
  "engines": {
    "node": ">=20"
  }
}
